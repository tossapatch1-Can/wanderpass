# Copy this file to .env.local and fill in your own values.
# (Never commit .env.local — it's already in .gitignore.)

# --- Supabase ---
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used for admin actions (moderation, stats) that bypass RLS.
# Get from Supabase Dashboard → Project Settings → API → service_role (secret)
# WARNING: never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic --- (Trip Planner AI itinerary)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend --- (welcome + wishlist reminder emails, Phase 5)
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM="Wanderpass <hello@yourdomain.com>"

# --- App ---
# Public base URL, used for OAuth redirect + share links.
# Local dev: http://localhost:3000 · Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret to protect the wishlist-reminder cron endpoint
# (GET /api/notify/wishlist-reminders). Any random string.
CRON_SECRET=change-me-to-a-random-string
